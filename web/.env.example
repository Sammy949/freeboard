# The canonical origin, used for absolute Open Graph, Twitter and canonical URLs.
# No trailing slash. On Vercel this can be left unset — the platform's own
# VERCEL_PROJECT_PRODUCTION_URL is used as a fallback.
NEXT_PUBLIC_SITE_URL=

# Analytics. Both are optional: leave them blank and no tag is rendered at all,
# which is what a clone of this repo should do by default. Set both to turn it
# on. Server-read, so no NEXT_PUBLIC_ prefix — the values reach the browser only
# as the attributes of the script tag itself.
#
# ANALYTICS_SCRIPT_URL is the full URL of the tracker script, e.g.
# https://<your-analytics-host>/script.js
# ANALYTICS_WEBSITE_ID is the site id that host issued for this property.
#
# Locally these belong in .env.production.local, NOT .env.local: Next loads that
# file for `next build` and `next start` but not for `next dev`, so development
# traffic never reaches the real dashboard. On a hosting platform, set them as
# project environment variables instead.
ANALYTICS_SCRIPT_URL=
ANALYTICS_WEBSITE_ID=
