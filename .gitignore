# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output. dist/ is gitignored but PUBLISHED — package.json's `files` ships it
# and the prepack hook builds it, so a publish can never carry a stale one.
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.npmrc

# Contract artifacts. NOT published-ignored: package.json's `files` allowlist SHIPS
# contracts/managed/freeboard/ deliberately, because NodeZkConfigProvider reads the
# prover keys from there at runtime and cli.js dynamically imports contract/index.js.
# Gitignored (they are build output, ~844K) but required in the tarball.
contracts/managed/

# Deployment info
deployment.json

# Wallet seed (sensitive)

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/

# Private state
*-state/

# Temporary files
tmp/
temp/

# Midnight network state (per-network seeds, deploy addresses)
.midnight-state.json

# Attester signing key (mock oracle — still a secret; see src/attester.ts)
.midnight-attester.json

# LevelDB store the private-state provider creates in cwd (default db name).
# Generated runtime state, and it holds private-state material — never commit it.
midnight-level-db/

# Midnight wallet sync state (per-network serialized wallet state cache)
.midnight-wallet-state/

# Proved-once scenario results. Bound to one chain and one deployment, so it is
# generated locally by `npm run prime` and never shared (see src/results-cache.ts).
.midnight-results.json

# Claude Code's per-project settings. Ignored by my global gitconfig too, but that
# protects only this machine — and npm does not consult a global gitignore at all, so
# `npm pack` shipped this file (326 permission entries naming absolute home paths and
# localhost ports) until package.json grew a `files` allowlist. Named here so the
# repo protects itself.
.claude/settings.local.json
.claude/settings.local.json.bak
