{
  "name": "freeboard",
  "version": "1.0.0",
  "type": "module",
  "description": "Prove a DeFi position is solvent without revealing it — zero-knowledge solvency proofs on Midnight",
  "author": "",
  "license": "MIT",
  "scripts": {
    "compile": "compact compile contracts/freeboard.compact contracts/managed/freeboard",
    "build": "npx tsc --noEmit || true",
    "setup": "npx tsx src/setup.ts",
    "deploy": "npx tsx src/deploy.ts",
    "cli": "npx tsx src/cli.ts",
    "check-balance": "npx tsx src/check-balance.ts",
    "network": "npx tsx src/network.ts",
    "devnet:start": "docker compose -f docker-compose.ledger9.yml up -d --wait",
    "devnet:stop": "docker compose -f docker-compose.ledger9.yml down",
    "devnet:clean": "docker compose -f docker-compose.ledger9.yml down -v",
    "proof-server:start": "docker compose up -d",
    "proof-server:stop": "docker compose down",
    "clean": "rm -rf contracts/managed .midnight-state.json .midnight-wallet-state",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:e2e": "tsx scripts/e2e-check.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.19.0-rc.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-types": "5.0.0-beta.7",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0-beta.7",
    "@midnight-ntwrk/wallet-sdk": "2.0.0-beta.2",
    "@scure/bip39": "2.2.0",
    "rxjs": "^7.8.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "@midnight-ntwrk/wallet-sdk-utilities": "1.2.1"
  },
  "keywords": ["midnight", "blockchain", "zero-knowledge", "privacy"]
}
